{
 "name": "okimemo-d1",
 "main": "worker.js",
 "compatibility_date": "2026-10-01",
 "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
 "d1_databases": [{"binding":"DB","database_name":"okimemo","database_id":"REPLACE_WITH_D1_DATABASE_ID"}],
 "vars": {"ALLOWED_EMAIL":"REPLACE_WITH_YOUR_EMAIL"}
}